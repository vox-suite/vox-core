# Must match AMAZON_SHOPPER_TOKEN in vox-core's .env
SHOPPER_TOKEN=change-me-to-match-AMAZON_SHOPPER_TOKEN
# true = stop on a highlighted "Place your order"; set false to really order
SHOPPER_DRY_RUN=true
