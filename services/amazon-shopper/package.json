{
  "name": "vox-amazon-shopper",
  "private": true,
  "type": "module",
  "description": "Local Playwright helper that lets Vox Core shop on amazon.in in a visible Chrome window",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "login": "node --env-file-if-exists=.env --import tsx src/login.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
