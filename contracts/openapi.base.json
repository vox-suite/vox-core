{
  "openapi": "3.1.0",
  "info": {
    "title": "Vox Core API",
    "version": "1.0.0",
    "description": "Unified API for Vox Core: consumer identity, conversations, spans, collections, records, schemas, jobs, events, and provider connections."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "SessionAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ServiceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Vox-Service-Token"
      },
      "AdminToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Vox-Admin-Token"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Collection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "trip",
              "event",
              "course",
              "area",
              "custom"
            ]
          },
          "status": {
            "type": "string"
          },
          "starts_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "span_count": {
            "type": "integer"
          }
        }
      },
      "Record": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "schema_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "goal",
              "insight"
            ]
          },
          "domain": {
            "type": "string"
          },
          "entity_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Span": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "active",
              "waiting_user",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "start_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "end_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "execution_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "autonomous",
              "interactive",
              "manual_human",
              null
            ]
          },
          "data": {
            "type": "object"
          },
          "collection_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "PulsePoint": {
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "SavedPulseChart": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "definition": {
            "$ref": "#/components/schemas/PulseDefinition"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PulseResult"
              }
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "definition",
          "created_at"
        ],
        "type": "object"
      },
      "Bucket": {
        "enum": [
          "day",
          "week",
          "month"
        ],
        "type": "string"
      },
      "SourceProfile": {
        "properties": {
          "action": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "connection_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "format": "int64",
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "dated_count": {
            "format": "int64",
            "type": "integer"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "first_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "key": {
            "type": "string"
          },
          "known_intervals": {
            "format": "int64",
            "type": "integer"
          },
          "last_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "samples": {
            "items": {},
            "type": "array"
          },
          "schema_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "timing": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "source",
          "category",
          "action",
          "timing",
          "currency",
          "count",
          "dated_count",
          "known_intervals",
          "fields",
          "samples"
        ],
        "type": "object"
      },
      "PulseConnection": {
        "properties": {
          "assistant_read": {
            "type": "boolean"
          },
          "authorization_state": {
            "type": "string"
          },
          "connector_id": {
            "type": "string"
          },
          "last_synced_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "sync_timeline": {
            "type": "boolean"
          }
        },
        "required": [
          "connector_id",
          "authorization_state",
          "sync_timeline",
          "assistant_read"
        ],
        "type": "object"
      },
      "PulseDefinition": {
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Bucket"
              }
            ]
          },
          "chart_type": {
            "$ref": "#/components/schemas/ChartType"
          },
          "dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "measurement_id": {
            "type": "string"
          },
          "period_days": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "timezone": {
            "type": "string"
          },
          "version": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "measurement_id",
          "period_days",
          "timezone",
          "chart_type"
        ],
        "type": "object"
      },
      "Measurement": {
        "properties": {
          "buckets": {
            "items": {
              "$ref": "#/components/schemas/Bucket"
            },
            "type": "array"
          },
          "default_dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "dimensions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/MeasurementKind"
          },
          "profile": {
            "$ref": "#/components/schemas/SourceProfile"
          },
          "quality": {
            "type": "string"
          },
          "scale": {
            "format": "double",
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "profile",
          "title",
          "description",
          "kind",
          "unit",
          "quality",
          "scale",
          "buckets",
          "dimensions"
        ],
        "type": "object"
      },
      "CanvasResponse": {
        "properties": {
          "charts": {
            "items": {
              "$ref": "#/components/schemas/SavedPulseChart"
            },
            "type": "array"
          },
          "legacy_boards": {
            "items": {},
            "type": "array"
          },
          "next_cursor": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "charts",
          "legacy_boards"
        ],
        "type": "object"
      },
      "SavePulseInput": {
        "additionalProperties": false,
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/PulseDefinition"
          },
          "idempotency_key": {
            "format": "uuid",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "idempotency_key",
          "title",
          "definition"
        ],
        "type": "object"
      },
      "DiscoveryResponse": {
        "properties": {
          "computed_at": {
            "format": "date-time",
            "type": "string"
          },
          "connections": {
            "items": {
              "$ref": "#/components/schemas/PulseConnection"
            },
            "type": "array"
          },
          "profiled_days": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "record_count": {
            "format": "int64",
            "type": "integer"
          },
          "source_count": {
            "minimum": 0,
            "type": "integer"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/PulseSuggestion"
            },
            "type": "array"
          }
        },
        "required": [
          "suggestions",
          "connections",
          "source_count",
          "record_count",
          "profiled_days",
          "computed_at"
        ],
        "type": "object"
      },
      "DiscoveryInput": {
        "additionalProperties": false,
        "properties": {
          "refresh": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "timezone"
        ],
        "type": "object"
      },
      "ChartType": {
        "enum": [
          "line",
          "bar",
          "pie",
          "area"
        ],
        "type": "string"
      },
      "MeasurementKind": {
        "enum": [
          "event_count",
          "numeric_sum",
          "numeric_average",
          "known_interval_duration",
          "recurring_cost_projection"
        ],
        "type": "string"
      },
      "PulseSuggestion": {
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/PulseDefinition"
          },
          "measurement": {
            "$ref": "#/components/schemas/Measurement"
          },
          "preview": {
            "$ref": "#/components/schemas/PulseResult"
          },
          "reason": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "reason",
          "definition",
          "measurement",
          "preview"
        ],
        "type": "object"
      },
      "PulseResult": {
        "properties": {
          "computed_at": {
            "format": "date-time",
            "type": "string"
          },
          "data_as_of": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/PulsePoint"
            },
            "type": "array"
          },
          "quality": {
            "type": "string"
          },
          "record_count": {
            "format": "int64",
            "type": "integer"
          },
          "source": {
            "type": "string"
          },
          "undated_count": {
            "format": "int64",
            "type": "integer"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "points",
          "unit",
          "quality",
          "description",
          "record_count",
          "undated_count",
          "computed_at"
        ],
        "type": "object"
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Process is ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/exchange": {
      "post": {
        "summary": "Exchange provider token for Vox consumer session",
        "responses": {
          "200": {
            "description": "Session created"
          }
        }
      }
    },
    "/v1/me": {
      "post": {
        "summary": "Get authenticated user profile and identities",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User details"
          }
        }
      }
    },
    "/v1/spans": {
      "post": {
        "summary": "Create span",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Span created"
          }
        }
      }
    },
    "/v1/collections": {
      "post": {
        "summary": "Create collection",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Collection created"
          }
        }
      }
    },
    "/v1/collections/{id}": {
      "post": {
        "summary": "Get collection",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Collection"
          }
        }
      }
    },
    "/v1/records": {
      "post": {
        "summary": "Create record",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Record created"
          }
        }
      }
    },
    "/v1/schemas": {
      "post": {
        "summary": "Create new schema version",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Schema created"
          }
        }
      }
    },
    "/v1/conversations/respond": {
      "post": {
        "summary": "Turn response for conversation",
        "security": [
          {
            "ServiceToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Agent turn response"
          }
        }
      }
    },
    "/v1/conversations/respond/stream": {
      "post": {
        "summary": "Streaming turn response for conversation",
        "security": [
          {
            "ServiceToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Text chunk stream"
          }
        }
      }
    },
    "/v1/conversations/complete": {
      "post": {
        "summary": "Complete conversation turn sequence",
        "security": [
          {
            "ServiceToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Completion recorded"
          }
        }
      }
    },
    "/v1/events": {
      "post": {
        "summary": "Ingest inbound observation event",
        "security": [
          {
            "ServiceToken": []
          },
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "202": {
            "description": "Event accepted"
          }
        }
      }
    },
    "/v1/schedules": {
      "post": {
        "summary": "Create schedule",
        "security": [
          {
            "ServiceToken": []
          },
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Schedule created"
          }
        }
      }
    },
    "/v1/action-proposals": {
      "post": {
        "summary": "Propose side effect action",
        "security": [
          {
            "ServiceToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Proposal created"
          }
        }
      }
    },
    "/v1/action-proposals/{id}/approve": {
      "post": {
        "summary": "Approve action proposal",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Approval registered"
          }
        }
      }
    },
    "/v1/devices": {
      "post": {
        "summary": "Enroll client device",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Device enrolled"
          }
        }
      }
    },
    "/v1/admin/audit-events": {
      "post": {
        "summary": "Admin view audit logs",
        "security": [
          {
            "AdminToken": []
          }
        ]
      }
    },
    "/v1/spans/{id}": {
      "post": {
        "summary": "Get span",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Span"
          }
        }
      }
    },
    "/v1/events/batch": {
      "post": {
        "summary": "Ingest a batch of inbound events",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "events"
                ],
                "properties": {
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "event_type",
                        "payload"
                      ],
                      "properties": {
                        "event_type": {
                          "type": "string"
                        },
                        "payload": {
                          "type": "object"
                        },
                        "idempotency_key": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch of events ingested successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/spans/list": {
      "post": {
        "summary": "List spans overlapping from/to, optionally by collection_id, status, or unscheduled",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Spans list"
          }
        }
      }
    },
    "/v1/collections/list": {
      "post": {
        "summary": "List collections",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Collections list"
          }
        }
      }
    },
    "/v1/collections/{id}/update": {
      "post": {
        "summary": "Update collection",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Collection updated"
          }
        }
      }
    },
    "/v1/collections/{id}/archive": {
      "post": {
        "summary": "Archive collection",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Collection archived"
          }
        }
      }
    },
    "/v1/collections/{id}/spans/{span_id}/add": {
      "post": {
        "summary": "Add span to collection",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Span added"
          }
        }
      }
    },
    "/v1/collections/{id}/spans/{span_id}/remove": {
      "post": {
        "summary": "Remove span from collection",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Span removed"
          }
        }
      }
    },
    "/v1/records/list": {
      "post": {
        "summary": "List records",
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Records list"
          }
        }
      }
    },
