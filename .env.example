# Vox Core Configuration
VOX_CORE_BIND_ADDRESS=0.0.0.0:3001
VOX_AUTH_TOKEN=change-me-to-a-secure-shared-token
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379
VOX_BRIDGE_URL=http://localhost:3000

# AI Models & Tools
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
EXA_API_KEY=your-exa-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Amazon.in shopping demo (services/amazon-shopper). Leave the URL empty to disable.
# Docker Desktop: http://host.docker.internal:4100, cargo run: http://127.0.0.1:4100
AMAZON_SHOPPER_URL=
AMAZON_SHOPPER_TOKEN=change-me-to-match-SHOPPER_TOKEN

LANGFUSE_SECRET_KEY=sk-lf-c674add8-7d6b-41cc-aeea-fd31dd129b1d
LANGFUSE_PUBLIC_KEY=pk-lf-1d3c8b68-1f8b-460f-9096-c63e620c33ab
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# true also sends prompts, replies, and tool arguments/results, which include
# callers' names, addresses, and phone numbers.
LANGFUSE_RECORD_CONTENT=false
# production, staging, or development; keeps test traces out of production views.
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional build or commit id shown on each trace.
LANGFUSE_RELEASE=

# Bridge voice and telephony
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-number
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
SARVAM_API_KEY=your-sarvam-api-key
VOX_STT_PROVIDER=assemblyai
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
VOX_TTS_PROVIDER=sarvam
SARVAM_API_KEY=your-sarvam-api-key

# Dedicated read-only administration credential; keep separate from service token.
VOX_ADMIN_TOKEN=
